rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Verificación de autenticación con correo electrónico
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    // 2. Lista de correos con acceso total de Administrador (Super Admins)
    function isSuperAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email.lower() in [
          'admin@porkos.pe'
          // Agrega aquí tu correo personal de Google/Gmail:
          // 'tu-correo@gmail.com'
        ] || (
          request.auth.token.email.matches('.*@porkos[.]pe') &&
          request.auth.token.email_verified == true
        )
      );
    }

    // 3. Verificar si el correo está registrado en la colección de usuarios (/users/{email})
    function isRegisteredEmail() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()));
    }

    // 4. Obtener documento del usuario registrado
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data;
    }

    // 5. Determinar el rol del usuario autenticado
    function getRole() {
      return isSuperAdminEmail()
        ? 'ADMIN'
        : (isRegisteredEmail() ? getUserDoc().role : 'GUEST');
    }

    // 6. Validar si el usuario tiene un correo debidamente autorizado
    function isAuthorizedUser() {
      return isSuperAdminEmail() || (isRegisteredEmail() && getRole() != 'GUEST');
    }

    // 7. Funciones de permisos por rol
    function isAdmin() {
      return isSuperAdminEmail() || getRole() == 'ADMIN' || getRole() == 'OWNER';
    }

    function isCoordinator() {
      return isAdmin() || getRole() == 'COORDINADOR';
    }

    function isKitchen() {
      return isCoordinator() || getRole() == 'COCINA';
    }

    function isCashier() {
      return isCoordinator() || getRole() == 'CAJERO';
    }

    // ==========================================
    // REGLAS ESPECÍFICAS POR COLECCIÓN
    // ==========================================

    // 1. Gestión de Usuarios y Accesos (/users/{userEmail}):
    // - Lectura: Exclusiva para usuarios autorizados
    // - Creación inicial: Solo Administradores, o auto-registro restringido exclusivamente a rol 'GUEST'
    // - Edición y eliminación: SOLO Administradores
    match /users/{userEmail} {
      allow read: if isAuthorizedUser();
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.email.lower() == userEmail.lower() &&
        !exists(/databases/$(database)/documents/users/$(userEmail.lower())) &&
        request.resource.data.role == 'GUEST'
      );
      allow update, delete: if isAdmin();
    }

    // 2. Contador Atómico de Secuencia Diaria (/app_config/order_counter):
    // - Lectura y actualización: Cajeros, Coordinadores y Administradores para numeración atómica
    match /app_config/order_counter {
      allow read: if isAuthorizedUser();
      allow write: if isCashier();
    }

    // 3. Configuración General del Sistema (/app_config/{configId}):
    // - Lectura: Usuarios autorizados
    // - Modificación: Administradores y Coordinadores
    match /app_config/{configId} {
      allow read: if isAuthorizedUser();
      allow write: if isCoordinator();
    }

    // 3. Pedidos y Comandas (/orders/{orderId}):
    // - Lectura: Usuarios autorizados del restaurante
    // - Creación: Cajero, Coordinador o Admin
    // - Modificación de estados (Cocina/Atención): Cocina, Cajero, Coordinador o Admin
    // - Eliminación o vaciado de historial: SOLO Coordinador o Admin
    match /orders/{orderId} {
      allow read: if isAuthorizedUser();
      allow create: if isCashier();
      allow update: if isKitchen() || isCashier();
      allow delete: if isCoordinator();
    }

    // 4. Catálogo Gastronómico (Productos, Categorías, Cremas, Extras, Empaques):
    // - Lectura: Usuarios autorizados
    // - Modificación: Administradores y Coordinadores
    match /products/{productId} {
      allow read: if isAuthorizedUser();
      allow write: if isCoordinator();
    }

    match /categories/{categoryId} {
      allow read: if isAuthorizedUser();
      allow write: if isCoordinator();
    }

    match /creams/{creamId} {
      allow read: if isAuthorizedUser();
      allow write: if isCoordinator();
    }

    match /extras/{extraId} {
      allow read: if isAuthorizedUser();
      allow write: if isCoordinator();
    }

    match /packagings/{packagingId} {
      allow read: if isAuthorizedUser();
      allow write: if isCoordinator();
    }

    // 5. Gastos Operativos y Caja (/expenses/{expenseId}):
    // - Lectura y Escritura: SOLO Coordinadores y Administradores (Cajeros y Cocina BLOQUEADOS)
    match /expenses/{expenseId} {
      allow read, write: if isCoordinator();
    }

    // 6. Mesas del Salón (/tables/{tableId}):
    // - Lectura: Usuarios autorizados
    // - Modificación: Cajero, Coordinador o Admin
    match /tables/{tableId} {
      allow read: if isAuthorizedUser();
      allow write: if isCashier();
    }

    // Bloqueo total por defecto para cualquier documento fuera de las colecciones autorizadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
