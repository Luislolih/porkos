rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Verificación básica: Usuario autenticado en Firebase con correo electrónico
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    // 2. Administradores y correos institucionales verificados
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() in [
          'admin@porkos.pe'
        ] || (
          request.auth.token.email.matches('.*@porkos[.]pe') &&
          request.auth.token.email_verified == true
        )
      );
    }

    // 3. Usuario registrado con rol operativo (no GUEST)
    function isStaff() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.token.email.lower())) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.token.email.lower())).data.role != 'GUEST'
      );
    }

    // 4. Coordinadores y Administradores autorizados para subir y borrar fotos del catálogo
    function canManageCatalogImages() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.token.email.lower())) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.token.email.lower())).data.role in ['ADMIN', 'OWNER', 'COORDINADOR']
      );
    }

    // Fotografías de productos del catálogo:
    // - Lectura: Personal autorizado del restaurante (no GUEST)
    // - Escritura / Subida / Eliminación: Exclusiva para Administradores, Dueño y Coordinador
    match /products/{allPaths=**} {
      allow read: if isStaff();
      allow write: if canManageCatalogImages()
        && request.resource.size < 300 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
      allow delete: if canManageCatalogImages();
    }

    // Bloqueo total por defecto para cualquier otra ruta dentro de Storage
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
